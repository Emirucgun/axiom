# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Supabase (Project Settings → API) --------------------------------------
# Public values: safe to ship to the browser. Security comes from RLS policies
# in supabase/migrations/001_initial_schema.sql, not from hiding these.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Show the "Continue with Google" button once the Google provider is enabled
# in Supabase (Authentication → Providers → Google).
VITE_ENABLE_GOOGLE_AUTH="false"

# --- Server-only secrets (never prefix with VITE_) ---------------------------
# Used exclusively by server.ts; never bundled into the frontend.

# REQUIRED for BYOK. Encrypts each user's Gemini key (AES-256-GCM) before it is
# stored in Postgres. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: changing it makes every saved user key undecryptable.
BYOK_ENCRYPTION_KEY="GENERATE_ME"

# OPTIONAL shared fallback. Users without their own key use this one.
# Leave empty to make BYOK mandatory (nobody spends your quota).
GEMINI_API_KEY=""

# Optional: server.ts falls back to the VITE_ values above when these are unset.
# SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# APP_URL: public URL where the app is hosted (OAuth redirect allow-list).
APP_URL="http://localhost:3000"
